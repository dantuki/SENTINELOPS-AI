{
  "name": "@sentinelops/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "API de producto de SentinelOps AI",
  "scripts": {
    "dev": "node --experimental-transform-types --import=./scripts/node-ts-register.mjs --env-file-if-exists=../../.env --watch src/server.ts",
    "admin": "node --experimental-transform-types --import=./scripts/node-ts-register.mjs --env-file-if-exists=../../.env src/admin.ts",
    "evaluate:inc001": "node --experimental-transform-types --import=./scripts/node-ts-register.mjs --env-file-if-exists=../../.env src/evaluate-inc001.ts",
    "migrate": "node --experimental-transform-types --import=./scripts/node-ts-register.mjs --env-file-if-exists=../../.env src/migrate.ts",
    "test:project-isolation": "node --experimental-transform-types --import=./scripts/node-ts-register.mjs --test tests/project-isolation.integration.test.ts",
    "test:postgres": "node --experimental-transform-types --import=./scripts/node-ts-register.mjs scripts/run-postgres-integration.ts",
    "evaluate:inc001:isolated": "node --experimental-transform-types --import=./scripts/node-ts-register.mjs scripts/run-inc001-evaluation.ts",
    "build": "tsc --project tsconfig.json",
    "start": "node --env-file-if-exists=../../.env dist/server.js",
    "test": "node --experimental-transform-types --import=./scripts/node-ts-register.mjs --test tests/app.test.ts tests/ingestion.test.ts tests/inc001-evaluation.test.ts tests/auth-security.test.ts tests/inc001-isolated-runner.test.ts tests/verified-fact-engine.test.ts",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "typecheck:runner": "tsc --ignoreConfig --noEmit --strict --target es2022 --module nodenext --moduleResolution nodenext --esModuleInterop --skipLibCheck scripts/run-inc001-evaluation.ts scripts/inc001-runner-lifecycle.ts tests/inc001-isolated-runner.test.ts"
  },
  "dependencies": {
    "fastify": "^5.12.7",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
