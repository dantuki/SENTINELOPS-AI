{
  "name": "@sentinelops/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "API de producto de SentinelOps AI",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --import=tsx --watch src/server.ts",
    "build": "tsc --project tsconfig.json",
    "start": "node --env-file-if-exists=../../.env dist/server.js",
    "test": "tsx --test tests/app.test.ts",
    "typecheck": "tsc --project tsconfig.json --noEmit"
  },
  "dependencies": {
    "fastify": "^5.12.7",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
