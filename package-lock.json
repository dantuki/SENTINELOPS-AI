{
  "name": "sentinelops-ai",
  "version": "0.1.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "sentinelops-ai",
      "version": "0.1.0",
      "workspaces": [
        "apps/web",
        "apps/api",
        "services/mcp-server",
        "packages/shared-contracts",
        "packages/config"
      ],
      "engines": {
        "node": ">=24.22.0 <25",
        "npm": ">=11.19.1 <12"
      }
    },
    "apps/api": {
      "name": "@sentinelops/api",
      "version": "0.1.0"
    },
    "apps/web": {
      "name": "@sentinelops/web",
      "version": "0.1.0"
    },
    "node_modules/@sentinelops/api": {
      "resolved": "apps/api",
      "link": true
    },
    "node_modules/@sentinelops/config": {
      "resolved": "packages/config",
      "link": true
    },
    "node_modules/@sentinelops/mcp-server": {
      "resolved": "services/mcp-server",
      "link": true
    },
    "node_modules/@sentinelops/shared-contracts": {
      "resolved": "packages/shared-contracts",
      "link": true
    },
    "node_modules/@sentinelops/web": {
      "resolved": "apps/web",
      "link": true
    },
    "packages/config": {
      "name": "@sentinelops/config",
      "version": "0.1.0"
    },
    "packages/shared-contracts": {
      "name": "@sentinelops/shared-contracts",
      "version": "0.1.0"
    },
    "services/mcp-server": {
      "name": "@sentinelops/mcp-server",
      "version": "0.1.0"
    }
  }
}
